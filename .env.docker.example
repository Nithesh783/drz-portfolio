# Application
NODE_ENV=production

# PostgreSQL
POSTGRES_DB=drz_portfolio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=4000
BACKEND_HOST_PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_MINUTES=60
WEB_ORIGIN=http://localhost:3001
# Frontend
FRONTEND_PORT=3000
FRONTEND_HOST_PORT=3001
FRONTEND_HOSTNAME=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3001

# Docker
DOCKER_BIND_ADDRESS=127.0.0.1
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_ACCESS_KEY=replace-with-your-rustfs-access-key
RUSTFS_SECRET_KEY=replace-with-a-long-random-rustfs-secret
RUSTFS_BUCKET=portfolio-media
RUSTFS_REGION=us-east-1
RUSTFS_OBJECT_PREFIX=portfolio
RUSTFS_HOST_PORT=9000
RUSTFS_CONSOLE_HOST_PORT=9001
