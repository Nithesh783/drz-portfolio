{
  "name": "@portfolio-drz/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run db:generate && nest build && tsc --project tsconfig.admin.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "db:generate": "tsx scripts/prisma-cli.ts generate",
    "db:migrate": "tsx scripts/prisma-cli.ts migrate deploy",
    "db:studio": "tsx scripts/prisma-cli.ts studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:create:compiled": "node dist/scripts/create-admin.js",
    "images:migrate": "tsx scripts/migrate-project-images.ts",
    "images:migrate:compiled": "node dist/scripts/migrate-project-images.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "eslint": "^10.15.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
